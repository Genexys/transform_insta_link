# Required
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Optional, but recommended for local DB-backed development
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/transform_insta_link
# Optional TLS override: disable | require | verify.
# Unset = no TLS for localhost, unverified TLS for any other host.
DATABASE_SSL=
ADMIN_CHAT_ID=123456789
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NODE_ENV=development
PORT=3000

# Self-hosted Instagram preview service (used for native carousel albums)
INSTA_PREVIEW_HOST=previewlinkbot.xyz
INSTA_PREVIEW_TOKEN=

# Retention for append-only tables, in days. Rows older than this are deleted
# once a day (irreversible). Set to 0 to keep rows forever.
LINK_EVENTS_RETENTION_DAYS=90
ERROR_LOGS_RETENTION_DAYS=30
